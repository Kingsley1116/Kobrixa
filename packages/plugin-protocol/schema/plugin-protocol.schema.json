{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kobrixa.com/schemas/plugin-protocol/1.0.0.json",
  "title": "Kobrixa plugin protocol 1.0.0",
  "$defs": {
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[\\^~]?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
            },
            {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                },
                "zh-TW": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "builtin"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "node"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "python"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "activationEvents": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^onCommand:[a-z0-9.-]+$"
          }
        },
        "permissions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ui.notifications"
            ]
          }
        },
        "contributes": {
          "type": "object",
          "properties": {
            "commands": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 128,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                          },
                          "zh-TW": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                          }
                        },
                        "required": [
                          "en"
                        ],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": {}
              }
            },
            "frontends": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  }
                },
                "required": [
                  "language"
                ],
                "additionalProperties": {}
              }
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "version",
        "apiVersion",
        "runtime"
      ],
      "additionalProperties": {}
    },
    "message": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[$A-Za-z][A-Za-z0-9/_-]*$"
            },
            "params": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[$A-Za-z][A-Za-z0-9/_-]*$"
            },
            "params": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "result": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              ]
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "message": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "initialize.params": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "zh-TW"
          ]
        },
        "grantedPermissions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ui.notifications"
            ]
          }
        }
      },
      "required": [
        "apiVersion",
        "pluginId",
        "locale",
        "grantedPermissions"
      ],
      "additionalProperties": false
    },
    "initialize.result": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sdk": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "sdk"
      ],
      "additionalProperties": false
    },
    "command/execute.params": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "command/execute.result": {
      "type": "null"
    },
    "shutdown.params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "shutdown.result": {
      "type": "null"
    },
    "ui/showMessage.params": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "ui/showMessage.result": {
      "type": "null"
    },
    "$/cancelRequest.params": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "exit.params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
}
