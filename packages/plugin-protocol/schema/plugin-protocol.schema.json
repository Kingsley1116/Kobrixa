{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kobrixa.com/schemas/plugin-protocol/1.3.0.json",
  "title": "Kobrixa plugin protocol 1.3.0",
  "$defs": {
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[\\^~]?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
            },
            {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                },
                "zh-TW": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "builtin"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "node"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "python"
                },
                "entry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "activationEvents": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^onCommand:[a-z0-9.-]+$"
          }
        },
        "permissions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ui.notifications"
            ]
          }
        },
        "contributes": {
          "type": "object",
          "properties": {
            "commands": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 128,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                          },
                          "zh-TW": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                          }
                        },
                        "required": [
                          "en"
                        ],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": {}
              }
            },
            "frontends": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "entryExtensions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]{1,16}$"
                    }
                  },
                  "sourceExtensions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]{1,16}$"
                    }
                  },
                  "ir": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "language",
                  "entryExtensions",
                  "sourceExtensions",
                  "ir"
                ],
                "additionalProperties": {}
              }
            },
            "backends": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "ir": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": {}
                  },
                  "capabilities": {
                    "type": "object",
                    "properties": {
                      "deploy": {
                        "type": "string",
                        "const": "ev3"
                      }
                    },
                    "additionalProperties": {}
                  },
                  "artifacts": {
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "slot": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        },
                        "kind": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        },
                        "extension": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,16}$"
                        },
                        "mediaType": {
                          "type": "string",
                          "maxLength": 127,
                          "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "deploy-main",
                            "aux"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "slot",
                        "kind",
                        "extension",
                        "mediaType",
                        "role",
                        "required"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "target",
                  "ir",
                  "capabilities",
                  "artifacts"
                ],
                "additionalProperties": {}
              }
            },
            "diagnosticHelp": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "number",
                  "const": 1
                },
                "path": {
                  "type": "string",
                  "maxLength": 600,
                  "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\/){0,7}[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\.json$"
                }
              },
              "required": [
                "version",
                "path"
              ],
              "additionalProperties": false
            },
            "languageServices": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "extensions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]{1,16}$"
                    }
                  },
                  "capabilities": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "analysis",
                        "completion",
                        "quickFixes",
                        "semanticTokens",
                        "hover",
                        "signatureHelp",
                        "definition",
                        "references",
                        "rename",
                        "documentSymbols",
                        "documentFormatting",
                        "rangeFormatting"
                      ]
                    }
                  }
                },
                "required": [
                  "language",
                  "extensions",
                  "capabilities"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "version",
        "apiVersion",
        "runtime"
      ],
      "additionalProperties": {}
    },
    "diagnostic-help": {
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "helpKey": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,100}$"
              },
              "title": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                  },
                  "zh-TW": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": false
              },
              "cause": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
                  },
                  "zh-TW": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": false
              },
              "steps": {
                "type": "object",
                "properties": {
                  "en": {
                    "minItems": 1,
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                    }
                  },
                  "zh-TW": {
                    "minItems": 1,
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                    }
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": false
              },
              "example": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
                  }
                },
                "required": [
                  "before",
                  "after"
                ],
                "additionalProperties": false
              },
              "links": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^https:\\/\\/[^\\u0000- \\u007F]+$"
                    },
                    "label": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                        },
                        "zh-TW": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
                        }
                      },
                      "required": [
                        "en"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "url",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "title",
              "cause",
              "steps"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "message": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[$A-Za-z][A-Za-z0-9/_-]*$"
            },
            "params": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[$A-Za-z][A-Za-z0-9/_-]*$"
            },
            "params": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "result": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              ]
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "message": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "initialize.params": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "pluginId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "zh-TW"
          ]
        },
        "grantedPermissions": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ui.notifications"
            ]
          }
        }
      },
      "required": [
        "apiVersion",
        "pluginId",
        "locale",
        "grantedPermissions"
      ],
      "additionalProperties": false
    },
    "initialize.result": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sdk": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "sdk"
      ],
      "additionalProperties": false
    },
    "command/execute.params": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "command/execute.result": {
      "type": "null"
    },
    "shutdown.params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "shutdown.result": {
      "type": "null"
    },
    "ui/showMessage.params": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]*$"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "ui/showMessage.result": {
      "type": "null"
    },
    "$/cancelRequest.params": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "exit.params": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
}
