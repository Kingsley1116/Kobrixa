{
  "name": "kobrixa",
  "private": true,
  "version": "0.1.0-v1-candidate.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --filter=!@kobrixa/desktop build && pnpm --filter @kobrixa/desktop dev",
    "build": "pnpm -r build",
    "build:core": "pnpm -r --filter \"./packages/**\" --filter \"./frontends/**\" build",
    "build:web": "pnpm --filter @kobrixa/web build",
    "build:desktop": "pnpm --filter @kobrixa/desktop package",
    "check:ci": "pnpm format:check && pnpm check && pnpm build:web",
    "test:ci": "vitest run && pnpm test:bytecode && pnpm test:examples:audit && pnpm test:release",
    "test:release": "node --test tools/release/*.test.mjs",
    "package:archive": "node tools/release/archive.mjs",
    "check": "pnpm -r check && eslint .",
    "test": "pnpm -r test && pnpm test:bytecode",
    "test:hardware": "node tests/hardware/run.mjs",
    "assets:build": "node tools/build-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm -r --filter=!@kobrixa/desktop build && pnpm --filter @kobrixa/desktop package",
    "examples:audit": "node tools/audit-new-examples.mjs",
    "test:examples:audit": "node --test tools/check-new-example-results.test.mjs",
    "examples:parity:audit": "node tools/audit-new-examples.mjs --selection examples/clev3r-parity.json",
    "examples:coverage": "node tools/check-example-coverage.mjs",
    "test:bytecode": "tsc -b packages/backend-ev3/tsconfig.json frontends/basic-plus/tsconfig.json && node --test tests/bytecode/*.test.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
