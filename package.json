{
  "name": "kobrixa",
  "private": true,
  "version": "1.0.1-beta.1",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --filter=!@kobrixa/desktop build && pnpm --filter @kobrixa/desktop dev",
    "build": "pnpm -r build",
    "build:core": "pnpm -r --filter \"./packages/**\" --filter \"./frontends/**\" build",
    "build:web": "pnpm --filter @kobrixa/web build",
    "build:desktop": "pnpm --filter @kobrixa/desktop package",
    "check:ci": "pnpm format:check && pnpm check && pnpm build:web",
    "test:ci": "vitest run && pnpm test:bytecode && pnpm test:release && pnpm test:static-languages && pnpm test:declarative-ui",
    "test:release": "node --test tools/release/*.test.mjs",
    "package:archive": "node tools/release/archive.mjs",
    "check": "pnpm -r check && eslint .",
    "test": "pnpm -r test && pnpm test:bytecode && pnpm test:static-languages && pnpm test:declarative-ui",
    "test:collab:live": "node tests/collab/run-live.mjs",
    "test:collab:remote": "node tests/collab/run-live.mjs --remote",
    "test:desktop:smoke": "node tests/desktop/run-smoke.mjs",
    "test:plugins:smoke": "node --test tests/desktop/plugins-smoke-process.test.mjs && node tests/desktop/run-plugins-smoke.mjs",
    "test:hardware": "node tests/hardware/run.mjs",
    "assets:build": "node tools/build-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm -r --filter=!@kobrixa/desktop build && pnpm --filter @kobrixa/desktop package",
    "test:bytecode": "tsc -b packages/backend-ev3/tsconfig.json frontends/basic-plus/tsconfig.json && node --test tests/bytecode/*.test.mjs",
    "check:web": "pnpm --filter \"@kobrixa/web...\" -r check && eslint apps/web packages/ir",
    "check:collab": "pnpm --filter @kobrixa/collab check && eslint apps/collab tests/collab",
    "check:desktop": "pnpm --filter \"@kobrixa/desktop...\" --filter @kobrixa/plugin-sdk -r check && eslint apps/desktop packages frontends tools tests assets",
    "check:common": "pnpm format:check && eslint \"*.mjs\" \"*.ts\" tools/ci && pnpm test:ci-routing",
    "test:web": "vitest run --project web --project @kobrixa/ir && pnpm --filter @kobrixa/web test:worker",
    "test:desktop": "vitest run --project \"!web\" && pnpm test:bytecode && pnpm test:release && pnpm test:python-sdk && pnpm test:static-languages && pnpm test:device-broker && pnpm test:declarative-ui",
    "test:python-sdk": "node tools/run-python-tests.mjs",
    "test:ci-routing": "node --test tools/ci/*.test.mjs",
    "package:installers": "pnpm --filter @kobrixa/desktop make",
    "package:updates": "node tools/release/update-assets.mjs",
    "test:desktop:packaged": "node tests/desktop/packaged-smoke.mjs && node tests/desktop/builtin-process-installed.mjs",
    "generate:static-language-core-ids": "node tools/generate-static-language-core-ids.mjs",
    "test:static-languages": "node tools/generate-static-language-core-ids.mjs --check && node --test tests/desktop/static-languages-*.test.mjs tests/desktop/smoke-harness.test.mjs",
    "test:static-languages:boundaries": "node tools/check-static-language-boundaries.mjs",
    "test:static-languages:smoke": "node tests/desktop/static-languages-run.mjs",
    "test:device-broker": "node --test tests/desktop/device-broker-*.test.mjs",
    "test:device-broker:smoke": "node tests/desktop/device-broker-run.mjs",
    "test:declarative-ui": "node --test tests/desktop/declarative-ui-*.test.mjs tests/desktop/builtin-process-*.test.mjs",
    "test:declarative-ui:smoke": "node tests/desktop/declarative-ui-run.mjs --transport-only && node tests/desktop/declarative-ui-browser-run.mjs && node tests/desktop/declarative-ui-motion-run.mjs --load"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
