{
  "id": "kobrixa.ev3",
  "version": "1.0.0",
  "apiVersion": "^1.1.0",
  "displayName": { "en": "EV3 native backend", "zh-TW": "EV3 原生後端" },
  "runtime": { "kind": "builtin" },
  "contributes": {
    "backends": [
      {
        "target": "ev3-native",
        "ir": { "min": 1, "max": 1 },
        "capabilities": { "deploy": "ev3" },
        "artifacts": [
          {
            "slot": "program",
            "kind": "rbf",
            "extension": "rbf",
            "mediaType": "application/octet-stream",
            "role": "deploy-main",
            "required": true
          },
          {
            "slot": "listing",
            "kind": "listing",
            "extension": "lst",
            "mediaType": "text/plain",
            "role": "aux",
            "required": false
          }
        ]
      }
    ]
  }
}
