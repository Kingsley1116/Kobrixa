{
  "id": "kobrixa.basic-plus",
  "version": "1.0.0",
  "apiVersion": "^1.4.0",
  "displayName": { "en": "Basic Plus", "zh-TW": "Basic Plus" },
  "runtime": { "kind": "builtin" },
  "contributes": {
    "languages": [
      {
        "id": "bp",
        "extensions": ["bp", "bpi", "bpm"],
        "aliases": ["Basic Plus", "Basic+"],
        "tokenizer": { "version": 1, "path": "language/tokenizer.json" },
        "configuration": { "version": 1, "path": "language/configuration.json" }
      }
    ],
    "frontends": [
      {
        "language": "bp",
        "entryExtensions": ["bp"],
        "sourceExtensions": ["bp", "bpi", "bpm"],
        "ir": { "min": 1, "max": 1 }
      }
    ],
    "languageServices": [
      {
        "language": "bp",
        "extensions": ["bp", "bpi", "bpm"],
        "capabilities": [
          "analysis",
          "completion",
          "quickFixes",
          "semanticTokens",
          "hover",
          "signatureHelp",
          "definition",
          "references",
          "rename",
          "documentSymbols",
          "documentFormatting",
          "rangeFormatting"
        ]
      }
    ]
  }
}
