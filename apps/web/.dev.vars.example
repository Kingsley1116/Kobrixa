# Gallery local development settings
# -----------------------------------------------------------------------------
# Copy this file to apps/web/.dev.vars, next to wrangler.jsonc, and fill in your
# local settings. Git ignores .dev.vars. This example can be committed, but it
# must never contain real secrets.
# These variables belong to the Worker, not the frontend. Do not prefix them
# with VITE_ or include their values in frontend code.
#
# Recommended setup (run the following pnpm commands from the repository root):
# 1. Create a separate GitHub OAuth App for local development. Do not reuse the
#    production OAuth App or its secret.
# 2. Fill in the variables below, then initialize local D1 with:
#    pnpm --filter @kobrixa/web db:local
# 3. Run pnpm --filter @kobrixa/web preview:worker and open SITE_ORIGIN/gallery.
# Restart the local Worker after editing .dev.vars to apply the new settings.
# See the Community Gallery section in the adjacent README.md for full local
# development and production deployment instructions.

# The site's origin: scheme + hostname + port, with no path, query, or trailing
# slash. The Worker uses this to build OAuth callback and post-login redirect
# URLs, and to check the Origin header on write requests.
# It must match the URL you open in the browser. Do not mix localhost and
# 127.0.0.1, since they are different origins.
# Default configuration for the Wrangler preview server:
#   GitHub OAuth App Homepage URL: http://localhost:8787
#   Authorization callback URL:  http://localhost:8787/api/auth/callback
# For Vite hot reload, change this to http://localhost:5173 and update the OAuth
# App URLs accordingly. Keep the Worker on port 8787; Vite proxies /api to it.
# HTTP is supported locally. Use HTTPS in production so the Worker sets Secure
# cookies with the __Host- prefix.
SITE_ORIGIN=http://localhost:8787

# Client ID from your local GitHub OAuth App's settings page. This is not the
# App ID or your GitHub user ID. The Client ID is not a secret, but it must
# belong to the same OAuth App as GITHUB_CLIENT_SECRET below.
# Sign-in reads the GitHub user identity without requesting repository access.
# Leaving either the Client ID or secret empty disables the sign-in entry point;
# OAuth sign-in endpoints return 503. Public media can still be browsed and
# downloaded anonymously, but submission and moderation require sign-in.
GITHUB_CLIENT_ID=

# Client secret generated by the same local OAuth App. The Worker uses it to
# exchange the OAuth authorization code with GitHub. This is not a Personal
# Access Token. Store it only in your private .dev.vars; do not commit it or
# paste it into conversations or logs.
# This file does not configure the production Worker's secret. For production,
# run the following command from apps/web:
#   pnpm exec wrangler secret put GITHUB_CLIENT_SECRET
# Enter the production OAuth App's secret at the interactive prompt. Do not
# include the secret itself in command-line arguments.
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub numeric user IDs for administrators, e.g. 123456,789012.
# Use the id field returned by the GitHub user API, not login, @username, email,
# or node_id. The backend authorizes users by their fixed ID, so renaming a
# GitHub account does not change its administrator access.
# Administrators can access pending submissions, approve or reject them, and
# remove published entries. Ordinary authors do not have these permissions.
# An empty value means there are no local administrators.
# This setting does not sign you in automatically or bypass GitHub authentication.
GALLERY_ADMIN_IDS=

# D1 (DB) and private R2 (MEDIA) are bindings in wrangler.jsonc; no storage keys
# are needed here. Normal wrangler dev uses locally simulated data. Apply local
# migrations with --local, not --remote.
# Configure production non-secret variables separately in wrangler.jsonc's vars.
# Do not deploy a localhost SITE_ORIGIN to production.
