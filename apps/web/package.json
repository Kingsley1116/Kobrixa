{
  "name": "@kobrixa/web",
  "version": "0.1.0-v1-candidate.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check && vite build",
    "check": "pnpm types:worker && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "preview:worker": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run && pnpm test:worker",
    "types:worker": "wrangler types --strict-vars=false",
    "test:worker": "node --test worker/gallery.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@kobrixa/compiler": "workspace:*",
    "@kobrixa/ir": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.1",
    "jsdom": "^30.1.1",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.129.0"
  }
}
