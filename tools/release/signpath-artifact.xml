<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <!-- upload-artifact creates the outer ZIP with the app directory's contents. -->
  <zip-file>
    <pe-file path="kobrixa.exe" product-name="Kobrixa" product-version="${version}" file-version="${version}" original-filename="kobrixa.exe">
      <authenticode-sign hash-algorithm="sha256" description="Kobrixa IDE" description-url="https://kobrixa.com" />
    </pe-file>
  </zip-file>
</artifact-configuration>
