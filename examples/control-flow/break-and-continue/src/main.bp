' Independently authored Kobrixa example
' Skip odd numbers and stop after the first three even numbers.
Folder "prjs" "Kobrixa"

count = 0
For value = 1 To 10
  If Math.Remainder(value, 2) <> 0 Then
    Continue
  EndIf
  count += 1
  If count = 3 Then
    Break
  EndIf
EndFor

LCD.Clear()
LCD.Text(1, 8, 18, 1, "Even values counted: " + count)
LCD.Update()