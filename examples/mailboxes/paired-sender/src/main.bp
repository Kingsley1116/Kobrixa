' Independently authored Kobrixa example
' Connect to a peer brick and send it text and number messages.
Folder "prjs" "Kobrixa"

Mailbox.Connect("KobrixaPeer")
Mailbox.Send("KobrixaPeer", "KobrixaText", "Hello peer")
Mailbox.SendNumber("KobrixaPeer", "KobrixaNumber", 12.5)
LCD.Text(1, 4, 16, 1, "Messages sent")
Program.Delay(1000)
