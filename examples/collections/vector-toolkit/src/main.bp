' Independently authored Kobrixa example
' Combine Vector.Data, Init, Add, and other Vector operations.
Folder "prjs" "Kobrixa"

a = Vector.Data(4, "3 -1 2")
b = Vector.Init(4, 2)
sum = Vector.Add(4, a, b)
sorted = Vector.Sort(4, a)
product = Vector.Multiply(1, 1, 4, a, b)
LCD.Text(1, 4, 12, 1, sum[0] + "," + sum[1] + "," + sum[2] + "," + sum[3])
LCD.Text(1, 4, 32, 1, sorted[0] + "," + sorted[1] + "," + sorted[2] + "," + sorted[3])
LCD.Text(1, 4, 52, 1, "Dot: " + product[0])
Program.Delay(1000)
