' Independently authored Kobrixa example
' Build the first Fibonacci numbers by repeatedly adding the previous two terms.
Folder "prjs" "Kobrixa"

previous = 0
current = 1
sequence = ""
For index = 0 To 7
  sequence = sequence + previous + " "
  next = previous + current
  previous = current
  current = next
EndFor
LCD.Clear()
LCD.Text(1, 4, 12, 1, sequence)
Program.Delay(1500)
