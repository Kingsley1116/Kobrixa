' Independently authored Kobrixa example
' Drive motors A and D with values from an included settings file.
Folder "prjs" "Kobrixa"

Include "lib/settings"

LCD.Clear()
LCD.Text(1, 8, 18, 1, "Using shared settings")
LCD.Update()
Motor.Move("AD", driveSpeed, travelDegrees, "True")
Program.Delay(pauseMs)
Motor.Stop("AD", "True")
