' Independently authored Kobrixa example
' Compose text from a math result and inspect the resulting text length.
Folder "prjs" "Kobrixa"

power = Math.Power(2, 8)
label = Text.Append("2^8 = ", power)
length = Text.GetLength(label)

LCD.Clear()
LCD.Text(1, 8, 18, 1, label)
LCD.Text(1, 8, 38, 1, "Characters: " + length) ' 沒有值
LCD.Update()