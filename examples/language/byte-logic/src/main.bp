' Independently authored Kobrixa example
' Apply a bit mask and format the result as hexadecimal text.
Folder "prjs" "Kobrixa"

masked = Byte.AND_(13, 7)
hex = Byte.ToHex(masked)

LCD.Clear()
LCD.Text(1, 8, 18, 1, "13 AND 7 = " + masked) ' 沒有值
LCD.Text(1, 8, 38, 1, "Hex: " + hex) ' 輸出了 00
LCD.Update()