' Independently authored Kobrixa example
' Display every raw channel of a sensor on a dashboard.
Folder "prjs" "Kobrixa"

Sensor.SetMode(1, 0)
percent = Sensor.ReadPercent(1)
Sensor.SetMode(1, 4)
channels = Sensor.ReadRaw(1, 3)
LCD.Text(1, 4, 12, 1, "Percent: " + percent)
LCD.Text(1, 4, 32, 1, channels[0] + "," + channels[1] + "," + channels[2])
Program.Delay(1000)
