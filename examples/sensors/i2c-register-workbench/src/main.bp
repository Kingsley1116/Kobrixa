' Independently authored Kobrixa example
' Read and write I2C registers with the complete register API.
Folder "prjs" "Kobrixa"

Sensor.WriteI2CRegister(1, 42, 16, 175)
one = Sensor.ReadI2CRegister(1, 42, 16)
values = Vector.Data(3, "128 175 255")
Sensor.WriteI2CRegisters(1, 42, 32, 3, values)
back = Sensor.ReadI2CRegisters(1, 42, 32, 3)
LCD.Text(1, 4, 12, 1, "Single: " + one)
LCD.Text(1, 4, 32, 1, back[0] + "," + back[1] + "," + back[2])
Program.Delay(1000)
