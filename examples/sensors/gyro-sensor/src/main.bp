' Independently authored Kobrixa example
' Keep the EV3 Gyro Sensor still on input port 1 while it initializes.
Folder "prjs" "Kobrixa"

Sensor.Wait(1)
Program.Delay(1000)
Sensor.SetMode(1, 0)

While True
  angle = Sensor.ReadRawValue(1, 0)
  LCD.Clear()
  LCD.Text(1, 8, 18, 1, "Gyro angle:")
  LCD.Text(1, 8, 48, 2, angle)
  LCD.Update()
  Program.Delay(100)
EndWhile
