' Independently authored Kobrixa example
' Sample a touch sensor on input port 1 four times.
Folder "prjs" "Kobrixa"

Sensor.Wait(1)
For sample = 1 To 4
  reading = Sensor.ReadPercent(1)
  If reading >= 50 Then
    Speaker.Tone(20, 880, 80)
  Else
    Speaker.Tone(15, 330, 50)
  EndIf
  Program.Delay(250)
EndFor
