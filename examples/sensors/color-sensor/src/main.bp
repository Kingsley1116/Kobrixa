' Independently authored Kobrixa example
' Read an EV3 Color Sensor on input port 1 in Color mode (mode 2).
Folder "prjs" "Kobrixa"

Sensor.Wait(1)
Sensor.SetMode(1, 2)

LCD.Clear()
While True
  color = Sensor.ReadRawValue(1, 0)
  LCD.Text(1, 8, 18, 1, "Color code:")
  LCD.Text(1, 8, 38, 1, color)
  LCD.Update()
  Program.Delay(100)
EndWhile
