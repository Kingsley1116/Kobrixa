' Independently authored Kobrixa example
' Inspect a sensor's type and mode, then read its value.
Folder "prjs" "Kobrixa"

Sensor.Wait(1)
LCD.Text(1, 4, 8, 1, Sensor.GetName(1))
LCD.Text(1, 4, 28, 1, "Type: " + Sensor.GetType(1))
Sensor.SetMode(1, 1)
If Not Sensor.IsBusy(1) Then
  LCD.Text(1, 4, 48, 1, "Mode: " + Sensor.GetMode(1))
  LCD.Text(1, 4, 68, 1, "Percent: " + Sensor.ReadPercent(1))
EndIf
Program.Delay(1000)
