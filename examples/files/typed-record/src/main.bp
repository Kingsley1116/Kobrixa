' Independently authored Kobrixa example
' Write and read a file record that mixes text and numbers.
Folder "prjs" "Kobrixa"

values = Vector.Data(3, "1.5 -2 8")
file = EV3File.OpenWrite("typed-record.dat")
EV3File.WriteLine(file, "sample")
EV3File.WriteByte(file, 175)
EV3File.WriteNumberArray(file, 3, values)
EV3File.Close(file)
file = EV3File.OpenRead("typed-record.dat")
label = EV3File.ReadLine(file)
version = EV3File.ReadByte(file)
loaded = EV3File.ReadNumberArray(file, 3)
EV3File.Close(file)
LCD.Text(1, 4, 12, 1, label + ": " + version)
LCD.Text(1, 4, 32, 1, loaded[0] + "," + loaded[1] + "," + loaded[2])
Program.Delay(1000)
