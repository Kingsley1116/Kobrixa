' Independently authored Kobrixa example
' Write a byte sequence to a file and read it back.
Folder "prjs" "Kobrixa"

handle = EV3File.OpenWrite("byte-sequence.bin")
EV3File.WriteByte(handle, 0)
EV3File.WriteByte(handle, 42)
EV3File.WriteByte(handle, 127)
EV3File.Close(handle)
handle = EV3File.OpenRead("byte-sequence.bin")
first = EV3File.ReadByte(handle)
second = EV3File.ReadByte(handle)
third = EV3File.ReadByte(handle)
EV3File.Close(handle)
LCD.Clear()
LCD.Text(1, 4, 12, 1, "Bytes: " + first + "," + second + "," + third)
Program.Delay(1500)
