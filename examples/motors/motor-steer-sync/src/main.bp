' Independently authored Kobrixa example
' Lift the robot before running. Motors A and D turn together with a steering bias.
Folder "prjs" "Kobrixa"

LCD.Clear()
LCD.Text(1, 8, 18, 1, "Steering A + D")
LCD.Update()
Motor.MoveSteer("AD", 35, 25, 360, true)
Motor.MoveSync("AD", 30, 10, 180, true)
Motor.Stop("AD", true)
