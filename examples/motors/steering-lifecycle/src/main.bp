' Independently authored Kobrixa example
' Start, adjust, and stop a steering pair on motors A and D.
Folder "prjs" "Kobrixa"

Motor.StartSteer("AD", 20, 25)
Program.Delay(80)
Motor.Stop("AD", true)
Motor.MoveSteer("AD", 20, -25, 90, true)
Motor.ScheduleSteer("AD", 15, 0, 90, true)
Motor.Wait("AD")
Motor.Stop("AD", true)
LCD.Text(1, 4, 16, 1, "Steering complete")
