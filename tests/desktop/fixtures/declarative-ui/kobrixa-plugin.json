{
  "id": "acceptance.ui",
  "version": "0.1.0",
  "apiVersion": "^1.6.0",
  "displayName": {
    "en": "UI acceptance",
    "zh-TW": "UI 驗收"
  },
  "runtime": {
    "kind": "node",
    "entry": "main.cjs"
  },
  "activationEvents": ["onCommand:acceptance.ui.activate"],
  "permissions": ["ui.panels", "ui.status"],
  "contributes": {
    "commands": [
      {
        "id": "acceptance.ui.activate",
        "title": {
          "en": "activate"
        },
        "invocation": "context-v1",
        "arguments": {
          "speed": {
            "type": "number",
            "min": -100,
            "max": 100,
            "integer": true,
            "nullable": false
          },
          "mode": {
            "type": "enum",
            "values": ["coast", "brake"],
            "nullable": false
          }
        }
      },
      {
        "id": "acceptance.ui.hold",
        "title": {
          "en": "hold"
        },
        "invocation": "context-v1",
        "arguments": {
          "speed": {
            "type": "number",
            "min": -100,
            "max": 100,
            "integer": true,
            "nullable": false
          },
          "mode": {
            "type": "enum",
            "values": ["coast", "brake"],
            "nullable": false
          }
        }
      },
      {
        "id": "acceptance.ui.legacy",
        "title": {
          "en": "Legacy"
        }
      }
    ],
    "panels": [
      {
        "id": "acceptance.ui.panel",
        "title": {
          "en": "UI acceptance",
          "zh-TW": "UI 驗收"
        },
        "location": "right",
        "resource": {
          "version": 1,
          "path": "panel.json"
        }
      }
    ],
    "status": [
      {
        "id": "acceptance.ui.status",
        "title": {
          "en": "UI status",
          "zh-TW": "UI 狀態"
        },
        "resource": {
          "version": 1,
          "path": "status.json"
        }
      }
    ]
  }
}
