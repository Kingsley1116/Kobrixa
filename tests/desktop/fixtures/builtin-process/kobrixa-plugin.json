{
  "id": "acceptance.ui",
  "version": "0.1.0",
  "apiVersion": "^1.6.0",
  "displayName": { "en": "Installed UI acceptance", "zh-TW": "安裝版 UI 驗收" },
  "runtime": { "kind": "node", "entry": "main.cjs" },
  "permissions": ["ui.panels"],
  "activationEvents": ["onCommand:acceptance.ui.activate"],
  "contributes": {
    "commands": [
      { "id": "acceptance.ui.legacy", "title": { "en": "Legacy" } },
      {
        "id": "acceptance.ui.activate",
        "title": { "en": "Activate" },
        "invocation": "context-v1",
        "arguments": {
          "speed": {
            "type": "number",
            "min": -100,
            "max": 100,
            "integer": true,
            "nullable": false
          },
          "mode": { "type": "enum", "values": ["coast", "brake"], "nullable": false }
        }
      },
      {
        "id": "acceptance.ui.hold",
        "title": { "en": "Hold" },
        "invocation": "context-v1",
        "arguments": {
          "speed": {
            "type": "number",
            "min": -100,
            "max": 100,
            "integer": true,
            "nullable": false
          },
          "mode": { "type": "enum", "values": ["coast", "brake"], "nullable": false }
        }
      }
    ],
    "panels": [
      {
        "id": "acceptance.ui.panel",
        "title": { "en": "Installed UI acceptance" },
        "location": "right",
        "resource": { "version": 1, "path": "panel.json" }
      }
    ]
  }
}
